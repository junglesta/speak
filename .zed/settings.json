// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
    "wrap_guides": [80],
    "allow_rewrap": "anywhere",
    "soft_wrap": "editor_width",
    "preferred_line_length": 80,
    // Our `src/data/*.yml` are plain config maps, but the JSON Schema Store
    // reserves names like `site.yml` for Ansible playbooks (root must be an
    // array) — which mis-flags the whole file. Disable store auto-association;
    // this repo has no YAML that needs a store schema.
    "lsp": {
        "yaml-language-server": {
            "settings": {
                "yaml": {
                    "schemaStore": { "enable": false }
                }
            }
        }
    }
}
