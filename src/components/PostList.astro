---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';

type Props = {
  posts: Post[];
  maxChars?: number;
  variant?: 'home' | 'archive';
  slug?: string;
};

const { posts, maxChars, variant = 'home', slug } = Astro.props;
const wrapperClass = variant === 'archive' ? `archive ${slug ?? ''}` : 'home';
---

<div class={wrapperClass}>
  <div class="posts">
    {posts.map((post) => <PostCard post={post} maxChars={maxChars} />)}
  </div>
</div>

<style>
  .home,
  .archive {
    background-color: var(--brand_color_back);
    position: relative;
  }

  /* Diagonal black-to-green slash leading into the post grid */
  .home::before,
  .archive::before {
    content: '';
    display: block;
    border-block-end: 1px solid transparent;
    border-block-start: 40px solid var(--dark_color);
    border-inline-end: 100vw solid transparent;
  }

  .posts {
    display: grid;
    gap: 2rem 1rem;
    grid-template-columns: 1fr;
    inline-size: 100%;
    margin-inline: auto;
    padding: var(--spaceV) var(--spaceH) 0;
  }

  @media (min-width: 32rem) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
      padding: calc(var(--spaceV) * 1.2) var(--spaceH) 0;
    }
  }

  @media (min-width: 48rem) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 5-column layout only for very wide displays (≥ 2024px). */
  @media (min-width: 126.5rem) {
    .posts {
      grid-template-columns: repeat(5, 1fr);
      gap: 3rem 1.5rem;
    }
  }
</style>
