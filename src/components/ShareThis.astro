---
import { stripHtml } from "../lib/excerpt";

type Props = {
	body: string;
	author?: string;
};

const { body, author } = Astro.props;

const text = stripHtml(body);
const authorPart = author ? `\n— ${author}` : "";
const quote = `"${text}"${authorPart}`;
---

<button
	class="share_this_button border_button uppercase"
	type="button"
	data-quote={quote}
	aria-label="Copy quote to clipboard"
>
	<span class="state_idle">
		Share this
		<svg class="share_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
			<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
		</svg>
	</span>
	<span class="state_copied" aria-live="polite">
		Copied
		<svg class="share_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polyline points="20 6 9 17 4 12"></polyline>
		</svg>
	</span>
</button>

<style>
	.share_this_button {
		margin: 0 auto;
	}

	.share_icon {
		inline-size: 1.25em;
		block-size: 1.25em;
		flex-shrink: 0;
	}

	.state_idle,
	.state_copied {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}

	.state_copied {
		display: none;
	}

	.share_this_button[data-copied] .state_idle {
		display: none;
	}

	.share_this_button[data-copied] .state_copied {
		display: inline-flex;
	}
</style>

<script>
	function initShareButtons() {
		document.querySelectorAll<HTMLButtonElement>(".share_this_button").forEach((btn) => {
			btn.addEventListener("click", async () => {
				const quote = btn.dataset.quote ?? "";
				try {
					await navigator.clipboard.writeText(quote);
					btn.setAttribute("data-copied", "");
					setTimeout(() => btn.removeAttribute("data-copied"), 2000);
				} catch {
					// fallback: select a temp textarea
					const ta = document.createElement("textarea");
					ta.value = quote;
					ta.style.position = "fixed";
					ta.style.opacity = "0";
					document.body.appendChild(ta);
					ta.select();
					document.execCommand("copy");
					document.body.removeChild(ta);
					btn.setAttribute("data-copied", "");
					setTimeout(() => btn.removeAttribute("data-copied"), 2000);
				}
			});
		});
	}

	initShareButtons();
	document.addEventListener("astro:page-load", initShareButtons);
</script>
