---
import { SITE } from '../lib/site';
import Favicons from './Favicons.astro';

type Props = {
  title?: string;
  description?: string;
  shareImage?: string;
  canonical?: string;
};

const { title, description, shareImage, canonical } = Astro.props;

const pageTitle = title
  ? `jungle speaks about ${title.toLowerCase()}`
  : 'Jungle Speaks';

const desc = description ?? SITE.description;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();

const ogImage = new URL(shareImage ?? SITE.default_share_image, SITE.url).toString();
---

<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>{pageTitle}</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={desc.replace(/\s+/g, ' ')} />
<meta name="keywords" content={SITE.keywords.join(', ')} />
<meta name="msapplication-tap-highlight" content="no" />
<link rel="canonical" href={canonicalUrl} />

<Favicons />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content="website" />

<meta name="twitter:card" content={SITE.twitter_card} />
<meta name="twitter:site" content={`@${SITE.twitter_username}`} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

<link rel="preconnect" href="https://www.googletagmanager.com" />
<meta name="google-site-verification" content={SITE.google_site_verification} />

<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/feed.xml" />
