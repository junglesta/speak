---
import menu from '../data/menu.json';
import { getAllPosts, postCategories } from '../lib/posts';
import { categoryBySlug } from '../lib/categories';

const posts = await getAllPosts();
const currentPath = Astro.url.pathname;
const sortedMenu = [...menu].sort((a, b) => a.name.localeCompare(b.name));

function countForMenuUrl(url: string): number {
  const slug = url.replace(/\//g, '');
  const key = categoryBySlug(slug);
  if (!key) return 0;
  return posts.filter((p) => postCategories(p).includes(key)).length;
}
---

<div id="nav" popover="auto" class="nav_overlay" aria-label="Sections">
  <button
    class="nav_close"
    type="button"
    popovertarget="nav"
    popovertargetaction="hide"
    aria-label="Close menu"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M18 6L6 18M6 6l12 12"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        fill="none"
      />
    </svg>
  </button>

  <nav class="nav_inner">
    {
      sortedMenu.map((item) => {
        const count = countForMenuUrl(item.url);
        const isCurrent = currentPath === item.url;
        return (
          <a
            class="page_link"
            href={item.url}
            data-current={isCurrent ? 'true' : undefined}
            aria-current={isCurrent ? 'page' : undefined}
          >
            <span class="page_title">{item.name}</span>
            {count > 0 && <span class="page_count">{count}</span>}
          </a>
        );
      })
    }
  </nav>
</div>

<style>
  /* Popover overlay — covers the viewport, dark background, brand-coloured.
     Mirrors SearchOverlay so menu and search feel like one system. */
  .nav_overlay {
    inline-size: 100dvw;
    block-size: 100dvh;
    max-inline-size: 100dvw;
    max-block-size: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background-color: var(--dark_color);
    color: var(--brand_color);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav_overlay::backdrop {
    background-color: oklch(0% 0 0 / 0.85);
  }

  /* Close X sits exactly where the menu trigger was (top-right), so the
     toggle reads as an icon morph rather than a jump. */
  .nav_close {
    position: absolute;
    inset-block-start: var(--corner_inset);
    inset-inline-end: var(--corner_inset);
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--brand_color);
    cursor: pointer;
    padding: 0;
    z-index: 1;
  }

  .nav_close svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .nav_close:hover,
  .nav_close:focus-visible {
    color: var(--brand_color_light);
    outline: none;
  }

  .nav_inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-block-size: 100%;
    padding: calc(var(--spaceV) * 2) var(--spaceH) var(--spaceV);
  }

  .page_link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    color: var(--brand_color);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: center;
    font-size: 1.5rem;
    min-block-size: var(--tap_size);
  }

  .page_link:hover,
  .page_link:focus-visible {
    color: var(--brand_color_light);
    outline: none;
  }

  /* Current page: dimmer green so the user knows where they are */
  .page_link[data-current='true'] {
    color: oklch(50% 0.22 137);
    pointer-events: none;
  }

  .page_count {
    color: oklch(50% 0.22 137);
    font-size: 0.875em;
    letter-spacing: 0;
  }
</style>
