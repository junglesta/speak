---
import { getAllPosts, postSlug } from '../lib/posts';
import { stripHtml } from '../lib/excerpt';
import BaseballHatIcon from '../icons/baseballhat.svg';
import RefreshIcon from '../icons/refresh.svg';

const posts = await getAllPosts();

const quotes = posts.map((p) => {
  const text = stripHtml(p.body ?? '').split(/\s+/).slice(0, 21).join(' ');
  return {
    href: `/${postSlug(p)}/`,
    text: text.length < (p.body ?? '').length ? `${text}…` : text,
  };
});

const quotesJson = JSON.stringify(quotes);
---

<header class="cover">
  <a class="cover_refresh" href="/" title="Load another random quote">
    <RefreshIcon aria-hidden="true" />
    <span class="hide">click to load another random quote</span>
  </a>

  <BaseballHatIcon class="cover_grafik" role="img" aria-label="JungleSpeaks" />

  <blockquote class="cover_bubble">
    <a id="random_quote" href="/">Loading a random thought…</a>
  </blockquote>
</header>

<script is:inline id="quotes_data" type="application/json" set:html={quotesJson} />

<script>
  type Quote = { href: string; text: string };
  const dataEl = document.getElementById('quotes_data');
  if (dataEl?.textContent) {
    try {
      const quotes = JSON.parse(dataEl.textContent) as Quote[];
      if (quotes.length) {
        const pick = quotes[Math.floor(Math.random() * quotes.length)];
        const anchor = document.getElementById('random_quote') as HTMLAnchorElement | null;
        if (anchor) {
          anchor.href = pick.href;
          anchor.textContent = pick.text;
        }
      }
    } catch {
      // leave fallback content
    }
  }
</script>

<style>
  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: var(--spaceV) var(--spaceH) calc(var(--spaceV) * 1.5);
    text-align: center;
    min-block-size: 100dvh;
    background-color: var(--dark_color);
  }

  .cover_refresh {
    position: absolute;
    inset-block-start: var(--corner_inset);
    inset-block-end: auto;
    inset-inline-start: auto;
    inset-inline-end: var(--corner_inset);
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brand_color);
    z-index: 2;
    contain: layout;
  }

  .cover_refresh svg {
    inline-size: 100%;
    block-size: 100%;
  }

  /* The big "Jungle Speak" hat is the hero element */
  .cover_grafik {
    inline-size: clamp(240px, 50vw, 480px);
    block-size: auto;
    color: var(--brand_color);
  }

  /* Green speech bubble below the hat, tail pointing UP into it */
  .cover_bubble {
    position: relative;
    margin-block-start: calc(var(--bubble_tail_size) + 0.5rem);
    padding: 1rem 1.5rem;
    background-color: var(--brand_color);
    color: var(--dark_color);
    border-radius: var(--border_radius);
    max-inline-size: min(90%, 36rem);
    box-shadow: 0 8px 24px oklch(0% 0 0 / 0.4);
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: outline-color 0.18s ease, outline-offset 0.18s ease;
  }

  .cover_bubble:hover,
  .cover_bubble:focus-within {
    outline-color: var(--brand_color);
    outline-offset: 6px;
  }

  .cover_bubble::before,
  .cover_bubble::after {
    content: '';
    position: absolute;
    inset-block-end: 100%;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    inline-size: 0;
    block-size: 0;
    border-style: solid;
    border-width: var(--bubble_tail_size);
    border-color: transparent transparent var(--brand_color) transparent;
  }

  .cover_bubble::before {
    filter: drop-shadow(0 -2px 2px oklch(0% 0 0 / 0.3));
  }

  .cover_bubble a {
    color: var(--dark_color);
    font-size: 1.5rem;
    line-height: 1.1;
    font-weight: 400;
    border: 0;
  }

  .cover_bubble a:focus-visible {
    outline: none;
  }
</style>
