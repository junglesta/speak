---
import { SITE } from "../../lib/site";
const isProd = import.meta.env.PROD;
---

{
  isProd && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${SITE.google_analytics}`}
      />
      <script is:inline define:vars={{ id: SITE.google_analytics }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', id);
      </script>

      {/* Cloudflare Web Analytics — runs alongside GA, not instead of it */}
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: SITE.cloudflare_analytics_token })}
      />
    </>
  )
}
