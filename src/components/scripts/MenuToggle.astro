<script>
  const btn = document.getElementById('menu_switch');
  const nav = document.getElementById('nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const opened = nav.classList.toggle('zipped');
      document.body.classList.toggle('menu_is_open', !opened);
      btn.setAttribute('aria-expanded', String(!opened));
    });
  }
</script>
