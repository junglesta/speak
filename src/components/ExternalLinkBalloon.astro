---
import ExternalLinkIcon from "../icons/external_link.svg";

type Kind = "goto" | "gocheck" | "alsocheck";

type Props = {
	kind: Kind;
	href: string;
	label: string;
	index: 1 | 2 | 3;
};

const { kind, href, label, index } = Astro.props;

// Tag every outbound link so the target site's analytics credit us as the
// referrer. Done here (not in post frontmatter) so it's one rule for all links;
// the URL API keeps existing query params and #fragments intact.
function withUtm(raw: string): string {
	try {
		const url = new URL(raw);
		url.searchParams.set("utm_source", "speak.junglestar.org");
		url.searchParams.set("utm_medium", "referral");
		return url.toString();
	} catch {
		return raw;
	}
}
const taggedHref = withUtm(href);
const action =
	kind === "goto"
		? "go-to-source"
		: kind === "gocheck"
			? "go-check"
			: "also-check";
---

<p class:list={[kind, 'hide']} id={`ballon${index}`}>
  <a target="_blank" rel="noopener" href={taggedHref} data-action={action} class="go_to_source border_button uppercase">
    <span class="ext_link_text">{label}</span>
    <span class="ext_link_ico">
      <ExternalLinkIcon class="external_link" aria-hidden="true" />
    </span>
  </a>
</p>

<style>
  p {
    text-align: center;
    margin: 0;
  }

  /* .go_to_source uses the shared .border_button + .uppercase. */
  .external_link {
    inline-size: 1.25em;
    block-size: 1.25em;
  }
</style>
