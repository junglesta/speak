---
import BaseLayout from "./BaseLayout.astro";
import RandomQuoteCover from "../components/RandomQuoteCover.astro";
import MenuIcon from "../icons/menu.svg";
import { SITE } from "../lib/site";

type Props = {
	postCount: number;
};
const { postCount } = Astro.props;
---

<BaseLayout isHome postCount={postCount}>
  <RandomQuoteCover />

  <header class="home_band">
    <a class="band_site_name" href="/">
      <span class="band_site_name__before">Jungle</span><span class="band_site_name__proper">{SITE.name}</span><span class="band_site_name__after">s</span>
    </a>

    <button class="band_menu" type="button" popovertarget="nav" aria-label="Open menu">
      <MenuIcon aria-hidden="true" />
    </button>
  </header>

  <slot />

  <p class="note">These ones here are just the newest quotes.</p>
</BaseLayout>

<style>
  .home_band {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    background-color: var(--dark_color);
    padding: var(--corner_inset) var(--corner_inset) 1rem 10vw;
  }

  .band_site_name {
    font-weight: 250;
    font-size: clamp(2rem, 5vw + 18px, 6rem);
    line-height: 1;
    letter-spacing: -1px;
    text-transform: uppercase;
  }

  .band_site_name__before,
  .band_site_name__after {
    color: oklch(50% 0.22 137);
  }

  .band_site_name__proper {
    color: var(--brand_color);
  }

  .band_site_name__before {
    margin-inline-end: 0.25ch;
  }

  .band_menu {
    background: transparent;
    border: none;
    color: var(--brand_color);
    margin: 0;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    align-self: flex-start;
  }

  .band_menu svg {
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }

  .note {
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--brand_color);
    margin-block: var(--spaceV) 1rem;
    padding-inline: 1rem;
  }

  .note:empty {
    display: none;
  }
</style>
