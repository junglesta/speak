{
  "name": "speak",
  "version": "3.8.1",
  "description": "Jungle Speaks — a volcano of vocabularising.",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "author": "rokma",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/junglesta/speak.git"
  },
  "scripts": {
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "clean": "rm -rf .astro dist node_modules/.vite",
    "start": "rm -rf .astro node_modules/.vite && astro dev",
    "dev": "rm -rf .astro node_modules/.vite && astro dev --open",
    "check": "rm -rf .astro node_modules/.vite && astro check --watch & astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --open",
    "deploy": "pnpm build && wrangler deploy",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:parity": "node tests/parity.mjs",
    "test": "astro check && vitest run && node tests/parity.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.6",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
