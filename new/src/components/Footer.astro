---
import { SITE } from '../lib/site';
import Icon from './Icon.astro';

type Props = { postCount?: number };
const { postCount } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__header">
    <p class="site__name">{SITE.name}</p>
  </div>

  <div class="footer__wrap">
    <section class="footer__section one">
      <p class="footer__catchphrase">We&nbsp;speak therefore&nbsp;we&nbsp;are.</p>
      <p class="site__description">{SITE.description}</p>

      <button id="qr_switch" class="qr_switch" type="button" aria-label="Show QR code">
        <span class="footer__icon qr"><Icon id="icn--speakqr" /></span>
      </button>
    </section>

    <section class="footer__section two">
      <p class="footer__catchphrase">About {SITE.name} project</p>

      {postCount !== undefined && (
        <p class="footer__txt">Collecting now {postCount} concepts!</p>
      )}

      <p>
        <span class="footer__icon"><Icon id="icn--singlish" /></span>
        <span class="footer__txt">Click face, see sources</span>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--feed" class="feed" /></span>
        <a class="footer__txt" href="/feed.xml">Feed for thoughts</a>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--cc" /></span>
        <a class="footer__txt" target="_blank" rel="noopener" href={SITE.license_link}>
          Source code and content released under a {SITE.license}
        </a>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--git" /></span>
        <a class="footer__txt" target="_blank" rel="noopener" title="Check out this website source code" href={SITE.repository}>
          Open source code on Github
        </a>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--netlify" /></span>
        <a class="footer__txt" target="_blank" rel="noopener" title="See this website source code" href="https://www.netlify.com">
          Hosted on Netlify CDN
        </a>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--copyright" /></span>
        <span class="footer__txt">Copyright &copy; 2012-{year} {SITE.copyright}.</span>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--junglestar" /></span>
        <a class="footer__txt" target="_blank" rel="noopener" title="This website was produced by Junglestar.org" href="http://junglestar.org">
          Jungle&#9733;star production
        </a>
      </p>
    </section>

    <section class="footer__section three">
      <p class="footer__catchphrase">Speak&nbsp;up! We&nbsp;&hearts;&nbsp;to&nbsp;listen.</p>

      <p>
        <span class="footer__icon"><Icon id="icn--mail" class="mail" /></span>
        <a class="footer__txt" title="connect via Email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>

      <p>
        <span class="footer__icon"><Icon id="icn--twitter" class="twitter" /></span>
        <a class="footer__txt" title="connect via Twitter" target="_blank" rel="noopener" href={`http://twitter.com/@${SITE.twitter_username}`}>
          @{SITE.twitter_username}
        </a>
      </p>

      <p>
        <a href="#top" title="return to the top of this page">
          <span class="footer__icon"><Icon id="icn--up" class="up" /></span>
          <span class="hide">return to the top of this page</span>
        </a>
      </p>
    </section>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--dark_color);
    color: var(--light_color);
    padding: 3rem 1rem 2rem;
    border-block-start: var(--border_size) solid var(--brand_color);
    margin-block-start: 4rem;
  }

  .footer__header {
    text-align: center;
    margin-block-end: 2rem;
  }

  .site__name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand_color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer__wrap {
    display: grid;
    gap: 2rem;
    inline-size: min(100%, 64rem);
    margin-inline: auto;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .footer__wrap {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer__section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__catchphrase {
    font-weight: 700;
    color: var(--brand_color);
    font-size: 1.125rem;
    margin-block-end: 0.5rem;
  }

  .footer__txt {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .footer__icon {
    display: inline-flex;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    vertical-align: middle;
    margin-inline-end: 0.5rem;
  }

  .footer__icon :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .qr_switch {
    background: transparent;
    border: var(--border_size) solid var(--brand_color);
    border-radius: var(--border_radius);
    padding: 0.5rem;
    cursor: pointer;
    align-self: flex-start;
  }

  .qr_switch .footer__icon {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    margin: 0;
  }

  .site__description {
    font-size: 0.875rem;
    line-height: 1.4;
    opacity: 0.8;
    white-space: pre-line;
  }

  .footer p {
    line-height: 1.5;
  }
</style>
