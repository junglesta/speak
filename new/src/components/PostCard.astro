---
import type { Post } from '../lib/posts';
import { postSlug, postDate, postCategories } from '../lib/posts';
import { primaryCategory } from '../lib/categories';
import { excerpt } from '../lib/excerpt';
import CategoryBadge from './CategoryBadge.astro';

type Props = {
  post: Post;
  maxChars?: number;
};

const { post, maxChars = 155 } = Astro.props;
const slug = postSlug(post);
const date = postDate(post);
const cats = postCategories(post);
const primary = primaryCategory(cats);
const { text, truncated } = excerpt(post.body ?? '', maxChars);
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="post">
  <CategoryBadge category={primary} size="card" />

  <a class="post_link" href={`/${slug}/`}>
    <span class="post_content">
      {text}
      {truncated && <span class="read_more">&nbsp;</span>}
    </span>
  </a>

  <div class="meta">
    <span class="post_date">{dateStr}</span>
    <span class="post_title">{post.data.title}</span>
  </div>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 1;
    border: var(--border_size) solid var(--brand_color);
    border-radius: var(--border_radius);
    padding: 1rem;
    overflow: hidden;
    background-color: oklch(0% 0 0 / 0.85);
    transition: transform var(--transition_duration) var(--transition_function),
                border-color var(--transition_duration) var(--transition_function);
  }

  .post:hover,
  .post:focus-within {
    transform: translateY(-2px);
    border-color: var(--brand_color_light);
  }

  .post_link {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--light_color);
    text-decoration: none;
  }

  .post_content {
    text-align: center;
    font-size: var(--bubble_font_size_small);
    line-height: 1.25;
    font-weight: 700;
  }

  .read_more::before {
    content: ' …more';
    color: var(--brand_color);
  }

  .meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-start: 1rem;
  }

  .post_date {
    color: var(--brand_color);
    font-weight: 700;
  }

  .post_title {
    color: var(--light_color);
    opacity: 0.7;
  }
</style>
