---
import { primaryCategory } from '../lib/categories';
import CategoryBadge from './CategoryBadge.astro';

type Props = {
  categories: string[];
  author?: string;
};

const { categories, author } = Astro.props;
const primary = primaryCategory(categories);
---

<div class="post_meta">
  <span class="author_ico" id="link_switch">
    <CategoryBadge category={primary} size="post" />
  </span>

  {author && <p class="author">{author}</p>}
</div>

<style>
  .post_meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 2rem;
  }

  .author_ico {
    cursor: pointer;
    display: inline-flex;
  }

  .author {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand_color);
    text-align: center;
  }
</style>
